# omnipanel.co — aaPanel site must point at etic-commerce, NOT /www/wwwroot/omnipanel.co
# Copy to: /www/server/panel/vhost/nginx/omnipanel.co.conf
# Do NOT create a separate empty site root in aaPanel; use this root instead.

server {
    listen 80;
    listen 443 ssl http2;
    server_name omnipanel.co www.omnipanel.co *.omnipanel.co;

    ssl_certificate /www/server/panel/vhost/cert/omnipanel.co/fullchain.pem;
    ssl_certificate_key /www/server/panel/vhost/cert/omnipanel.co/privkey.pem;
    ssl_protocols TLSv1.1 TLSv1.2 TLSv1.3;
    ssl_ciphers EECDH+CHACHA20:EECDH+CHACHA20-draft:EECDH+AES128:RSA+AES128:EECDH+AES256:RSA+AES256:EECDH+3DES:RSA+3DES:!MD5;
    ssl_prefer_server_ciphers on;
    ssl_session_tickets on;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 10m;
    add_header Strict-Transport-Security "max-age=31536000";
    error_page 497 https://$host$request_uri;

    root /www/wwwroot/etic-commerce/public;
    index index.php index.html;

    include /www/server/panel/vhost/nginx/extension/omnipanel.co/*.conf;
    include /www/server/panel/vhost/nginx/well-known/omnipanel.co.conf;

    access_log /www/wwwlogs/omnipanel.co.log;
    error_log /www/wwwlogs/omnipanel.co.error.log;

    client_max_body_size 64m;

    include /www/wwwroot/etic-commerce/deploy/nginx/laravel-locations.conf;

    location ^~ /.well-known/ {
        alias /www/wwwroot/omnipanel.co/.well-known/;
        allow all;
    }

    location / {
        proxy_pass http://127.0.0.1:3010;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_connect_timeout 2s;
        proxy_read_timeout 60s;
        proxy_intercept_errors on;
        error_page 502 503 504 = @blade;
    }

    location @blade {
        try_files $uri $uri/ /index.php?$query_string;
    }

    include enable-php-83.conf;

    location ~ ^/(\.user.ini|\.htaccess|\.git|\.env|\.svn|\.project|LICENSE|README.md) {
        return 404;
    }
}
