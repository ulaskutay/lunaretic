# Laravel e-commerce — nginx example
server {
    listen 80;
    listen 443 ssl http2;
    server_name eticcommerce.com www.eticcommerce.com;
    ssl_certificate /www/server/panel/vhost/cert/etic-commerce/fullchain.pem;
    ssl_certificate_key /www/server/panel/vhost/cert/etic-commerce/privkey.pem;

    root /www/wwwroot/etic-commerce/public;
    index index.php index.html;

    access_log /www/wwwlogs/etic-commerce-platform.log;
    error_log /www/wwwlogs/etic-commerce-platform.error.log;

    client_max_body_size 64m;

    include /www/wwwroot/etic-commerce/deploy/nginx/laravel-locations.conf;

    location / {
        try_files $uri $uri/ /index.php?$query_string;
    }

    include enable-php-83.conf;

    location ~ ^/(\.user.ini|\.htaccess|\.git|\.env) {
        return 404;
    }
}

# Mağaza subdomainleri — Next.js vitrin + Laravel API/ödeme
server {
    listen 80;
    listen 443 ssl http2;
    server_name *.eticcommerce.com;
    ssl_certificate /www/server/panel/vhost/cert/etic-commerce/fullchain.pem;
    ssl_certificate_key /www/server/panel/vhost/cert/etic-commerce/privkey.pem;

    root /www/wwwroot/etic-commerce/public;
    index index.php index.html;

    access_log /www/wwwlogs/etic-commerce.log;
    error_log /www/wwwlogs/etic-commerce.error.log;

    client_max_body_size 64m;

    include /www/wwwroot/etic-commerce/deploy/nginx/laravel-locations.conf;

    location / {
        proxy_pass http://127.0.0.1:3010;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 2s;
        proxy_read_timeout 60s;
        proxy_intercept_errors on;
        error_page 502 503 504 = @blade;
    }

    location @blade {
        try_files $uri $uri/ /index.php?$query_string;
    }

    include enable-php-83.conf;

    location ~ ^/(\.user.ini|\.htaccess|\.git|\.env) {
        return 404;
    }
}

# IP erişimi — mevcut tek mağaza / geliştirme
