[Unit]
Description=Etic Commerce queue worker
After=network.target

[Service]
Type=simple
User=www
Group=www
WorkingDirectory=/www/wwwroot/etic-commerce
ExecStart=/usr/bin/php /www/wwwroot/etic-commerce/artisan queue:work --sleep=1 --tries=3 --timeout=900 --max-time=3600
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
